{
  "name": "electron_app",
  "version": "1.0.0",
  "description": "CareConnect Electron desktop app",
  "main": "index.js",
  "scripts": {
    "start": "electron .",
    "test": "jest --coverage",
    "test:watch": "jest --watch --coverage",
    "build": "electron-builder --win",
    "build:portable": "electron-builder --win portable",
    "watch": "nodemon --exec electron . --watch electron_app/ --ext html,css,js",
    "test:integration": "jest --testPathPattern=integration --testTimeout=20000"
  },
  "build": {
    "appId": "com.careconnect.team7",
    "productName": "CareConnect",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "electron": "^39.2.7"
  },
  "devDependencies": {
    "electron-builder": "^25.1.8",
    "jest": "^29.7.0",
    "jsdom": "^25.0.1",
    "nodemon": "^3.1.14",
    "playwright": "^1.58.2"
  }
}
